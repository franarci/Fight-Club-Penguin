[node name="Objective" type="Label" parent="Background/Center/Panel/Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 22
text = "Be the last penguin standing!

Push rivals off the ice or attack them to take their lives.
Falling off the ice or running out of HP costs one life.
Lose all three lives and you are eliminated.

Matches last up to 5 minutes.
When time runs out: most lives wins, then most HP.
Still tied? It's a draw."
horizontal_alignment = 1
vertical_alignment = 1

